{
  "name": "octo-draw",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @octo-draw/web --filter @octo-draw/server dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:packages": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "cli": "node apps/cli/bin/octo-draw.mjs",
    "icons:fetch": "node --experimental-strip-types --no-warnings packages/core/scripts/fetch-cloud-icons.ts",
    "mcp": "pnpm --silent --dir apps/server mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
