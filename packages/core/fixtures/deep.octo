			Issuer cluster [icon: kubernetes] {
				Issuer pod [icon: box] {
					Connector [icon: plug, src: "local:services/payments/src/issuer/connector.ts#Connector"]
					Retry queue [icon: layers]
				}
				Sidecar
			}
			HSM [icon: lock]
		}
	}
}
